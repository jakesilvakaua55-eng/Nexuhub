{
  "name": "NexHub",
  "short_name": "NexHub",
  "description": "Comunidades, chamadas, VIP, Pix e selos oficiais.",
  "id": "/app",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "orientation": "portrait-primary",
  "background_color": "#111114",
  "theme_color": "#18181d",
  "categories": [
    "social",
    "communication",
    "productivity"
  ],
  "lang": "pt-BR",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Mensagens privadas",
      "short_name": "PV",
      "url": "/app?tab=dms",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Notificações",
      "short_name": "Avisos",
      "url": "/app?tab=notifications",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Configurações",
      "short_name": "Perfil",
      "url": "/app?tab=settings",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
